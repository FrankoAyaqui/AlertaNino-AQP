APP_NAME="AlertaNiño AQP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# En produccion (HTTPS) debe ser true para que la cookie solo viaje cifrada:
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AlertaNiño AQP: fuentes oficiales
# Espejo publicado desde Perú (GitHub Pages) que se usa si SENAMHI no responde al servidor.
ALERTA_ESPEJO_URL=https://frankoayaqui.github.io/AlertaNino-AQP/data/indicadores.json
ALERTA_HTTP_TIMEOUT=25

# ----------------------------------------------------------------------------
# Seguridad en produccion (servidor publico con HTTPS, idealmente en Peru):
#   APP_ENV=production
#   APP_DEBUG=false            (nunca true en produccion: filtra detalles internos)
#   SESSION_SECURE_COOKIE=true (la cookie solo viaja por HTTPS)
# APP_KEY lo genera "php artisan key:generate" y NO se comparte ni se sube a Git.
